{
  "name": "headroomd",
  "version": "0.1.0-beta.1",
  "description": "Your agents know their budget: live quota, resets and pace states for every AI subscription and account, over CLI, daemon and MCP.",
  "keywords": [
    "claude",
    "codex",
    "gemini",
    "antigravity",
    "quota",
    "rate-limit",
    "usage",
    "mcp",
    "agents",
    "cli"
  ],
  "homepage": "https://github.com/Apertur3/headroom#readme",
  "bugs": {
    "url": "https://github.com/Apertur3/headroom/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Apertur3/headroom.git"
  },
  "license": "MIT",
  "author": "the maintainer Hermans",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23.0.0 || >=23.4.0"
  },
  "bin": {
    "headroom": "bin/headroom.js"
  },
  "files": [
    "dist",
    "bin",
    "bin/probe/**",
    "engine.lock.json",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "examples",
    "skills",
    "docs/*.md",
    "docs/assets/*.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "(npm run build && bash scripts/build-probe.sh) 1>&2",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "engine:build": "bash scripts/build-engine.sh",
    "smoke-cold": "bash scripts/smoke-cold.sh",
    "release:check": "bash scripts/release-check.sh"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  }
}
